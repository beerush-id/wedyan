{
  "name": "wedyan",
  "private": true,
  "version": "0.0.1",
  "description": "A browser desktop you share with your AI agent: same apps, same tools, real structured state.",
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "homepage": "https://wedyan.airlib.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beerush-id/wedyan.git"
  },
  "bugs": {
    "url": "https://github.com/beerush-id/wedyan/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 6173",
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr --outDir dist/server",
    "start": "NODE_ENV=production bun run server/bun.js",
    "start:node": "NODE_ENV=production node server/node.js",
    "start:deno": "NODE_ENV=production deno run --allow-net --allow-read --allow-env server/deno.js",
    "lint": "biome check",
    "test": "vitest --run",
    "test:live": "vitest --run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@airlib/aria": "workspace:*",
    "@airlib/aui": "workspace:*",
    "@airlib/react": "workspace:*",
    "@airlib/react-aui": "workspace:*",
    "@beerush/logger": "^0.0.8",
    "@cloudflare/containers": "^0.3.7",
    "@irpclib/ai-kit": "workspace:*",
    "@irpclib/http": "workspace:*",
    "@irpclib/irpc": "workspace:*",
    "@irpclib/r2-file": "workspace:*",
    "@irpclib/r2-image": "workspace:*",
    "@irpclib/ws": "workspace:*",
    "gsap": "catalog:lib",
    "mediabunny": "^1.62.1",
    "react": "catalog:app",
    "react-dom": "catalog:app",
    "zod": "catalog:lib"
  },
  "devDependencies": {
    "@airlib/vite": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:lib",
    "@types/react-dom": "catalog:lib",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
