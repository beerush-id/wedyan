{
  "name": "wedyan",
  "private": true,
  "version": "2.3.0",
  "description": "A browser desktop you share with your AI agent: same apps, same tools, real structured state.",
  "author": "Nanang Mahdaen El Agung <mahdaen@gmail.com>",
  "homepage": "https://wedyan.airlib.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beerush-id/wedyan.git"
  },
  "bugs": {
    "url": "https://github.com/beerush-id/wedyan/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 6173",
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr --outDir dist/server",
    "start": "NODE_ENV=production bun run server/bun.js",
    "start:node": "NODE_ENV=production node server/node.js",
    "start:deno": "NODE_ENV=production deno run --allow-net --allow-read --allow-env server/deno.js",
    "deploy": "bun run build && wrangler deploy --env production",
    "lint": "biome check",
    "test": "vitest --run",
    "test:live": "vitest --run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@airlib/aria": "2.3.0",
    "@airlib/aui": "2.3.0",
    "@airlib/react": "2.3.0",
    "@airlib/react-aui": "2.3.0",
    "@beerush/logger": "^0.0.8",
    "@cloudflare/containers": "^0.3.7",
    "@irpclib/ai-kit": "2.3.0",
    "@irpclib/http": "2.3.0",
    "@irpclib/irpc": "2.3.0",
    "@irpclib/r2-file": "2.3.0",
    "@irpclib/r2-image": "2.3.0",
    "@irpclib/ws": "2.3.0",
    "gsap": "3.15.0",
    "mediabunny": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "temml": "^0.14.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@airlib/vite": "2.3.0",
    "@biomejs/biome": "^2.5.6",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.11"
  }
}
