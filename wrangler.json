{
	"$schema": "https://unpkg.com/wrangler/config-schema.json",
	"name": "wedyan-app",
	"main": "./server/worker.js",
	"compatibility_date": "2025-06-10",
	"compatibility_flags": [
		"nodejs_compat",
		"enable_request_signal"
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "DURABLE_LINK",
				"class_name": "AirDurableLink"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_classes": [
				"AirDurableLink"
			]
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "wedyan-memory-dev",
			"remote": true
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "wedyan-files"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wedyan-index",
			"database_id": "local-wedyan-index"
		}
	]
}